<manifest xmlns:android="http://schemas.android.com/apk/res/android" >

  <application>
    <!--
    Plugin metadata:
    - android:name uses the org.godotengine.plugin.v2 prefix (required for Godot 4.2+).
      The plugin name after the prefix must match getPluginName() in GodotNoctua.java.
    - android:value is the fully-qualified class name of the plugin initializer.
    -->
    <meta-data
        android:name="org.godotengine.plugin.v2.GodotNoctua"
        android:value="com.slabgames.noctua.GodotNoctua" />

  </application>

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>
